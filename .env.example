# Fair Bounty Judge project-wide configuration. Copy this file to the repository-root .env.
# The API ignores blockchain-only values; Hardhat ignores API-only values.

# Application and persistence
APP_ENV=development
FIXTURE_MODE=true
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=fair_bounty_judge
DATABASE_MODE=memory

# GitHub App
GITHUB_WEBHOOK_SECRET=replace-me
GITHUB_ALLOWED_REPOSITORIES=
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
# Base64-encode the downloaded GitHub App .pem file.
GITHUB_APP_PRIVATE_KEY_B64=
GITHUB_CHECK_NAME=Fair Bounty Judge

# Review agents and evidence storage
AI_PROVIDER=fixture
AI_MODEL=fixture-v1
AI_TIMEOUT_SECONDS=45
AI_MAX_DIFF_CHARS=30000
AI_PROMPT_VERSION=review-v1
GROQ_API_KEY=
IPFS_PROVIDER=fixture
PINATA_JWT=
PINATA_API_URL=https://api.pinata.cloud/pinning/pinFileToIPFS
IPFS_GATEWAY_URL=https://gateway.pinata.cloud/ipfs

# Polygon Amoy deployment and contract configuration
AMOY_RPC_URL=https://polygon-amoy.drpc.org
CHAIN_ID=80002
# Private key without a 0x prefix. Use a testnet-only deployment wallet.
DEPLOYER_PRIVATE_KEY=
DEFAULT_REWARD_TOKEN=
BOUNTY_ESCROW_ADDRESS=
VERDICT_REGISTRY_ADDRESS=
DISPUTE_MANAGER_ADDRESS=
REWARD_TOKEN_ADDRESS=
RELAYER_ADDRESS=
DISPUTE_RESOLVER_ADDRESS=
# Service keys: keep the relayer and resolver keys separate from the deployment key when possible.
RELAYER_PRIVATE_KEY=
DISPUTE_RESOLVER_PRIVATE_KEY=
CHAIN_EVENT_POLL_SECONDS=15
CHAIN_EVENT_CONFIRMATIONS=3
# Set to the deployment block to replay historical events. Leave empty to begin at the current confirmed block.
CHAIN_EVENT_START_BLOCK=
