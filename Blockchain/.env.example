# Polygon Amoy JSON-RPC endpoint. Keep this out of source control.
AMOY_RPC_URL=https://polygon-amoy.drpc.org

# Private key for the deployment wallet, with no 0x prefix.
DEPLOYER_PRIVATE_KEY=

# Wallet allowed to publish signed-off-chain verdict evidence.
RELAYER_ADDRESS=

# Wallet or multisig allowed to resolve disputes.
DISPUTE_RESOLVER_ADDRESS=

# Required for deploy:amoy. Deploy MockUSDC separately only when a demo token is needed.
DEFAULT_REWARD_TOKEN=

# Existing addresses for deploy:resume:amoy and roles:check:amoy. Leave registry/manager empty to deploy only what is missing.
BOUNTY_ESCROW_ADDRESS=
VERDICT_REGISTRY_ADDRESS=
DISPUTE_MANAGER_ADDRESS=

