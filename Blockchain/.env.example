# Polygon Amoy JSON-RPC endpoint. Keep this out of source control.
AMOY_RPC_URL=https://polygon-amoy.drpc.org

# Private key for the deployment wallet, with no 0x prefix.
DEPLOYER_PRIVATE_KEY=

# Wallet allowed to publish signed-off-chain verdict evidence.
RELAYER_ADDRESS=

# Wallet or multisig allowed to resolve disputes.
DISPUTE_RESOLVER_ADDRESS=

# Default ERC-20 reward token (for example, a test USDC deployment on Amoy).
DEFAULT_REWARD_TOKEN=

