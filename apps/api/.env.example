APP_ENV=development
FIXTURE_MODE=true
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=fair_bounty_judge
DATABASE_MODE=memory
GITHUB_WEBHOOK_SECRET=replace-me
GITHUB_ALLOWED_REPOSITORIES=https://github.com/shivaaggrawal/Image-Editor
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
# Base64-encode the downloaded GitHub App .pem file and set it here.
GITHUB_APP_PRIVATE_KEY_B64=
GITHUB_CHECK_NAME=Fair Bounty Judge
AI_PROVIDER=fixture
AI_MODEL=fixture-v1
AI_TIMEOUT_SECONDS=45
AI_MAX_DIFF_CHARS=30000
AI_PROMPT_VERSION=review-v1
GROQ_API_KEY=
IPFS_PROVIDER=fixture
PINATA_JWT=
PINATA_API_URL=https://api.pinata.cloud/pinning/pinFileToIPFS
IPFS_GATEWAY_URL=https://gateway.pinata.cloud/ipfs
AMOY_RPC_URL=
CHAIN_ID=80002
BOUNTY_ESCROW_ADDRESS=
VERDICT_REGISTRY_ADDRESS=
DISPUTE_MANAGER_ADDRESS=
REWARD_TOKEN_ADDRESS=
RELAYER_PRIVATE_KEY=
# Optional server-side signer for `resolveDispute`. Leave empty when the resolver signs from a wallet.
DISPUTE_RESOLVER_PRIVATE_KEY=
CHAIN_EVENT_POLL_SECONDS=15
CHAIN_EVENT_CONFIRMATIONS=3
# Set this to the deployment block to replay historical events. Leave empty to start at the current confirmed block.
CHAIN_EVENT_START_BLOCK=
